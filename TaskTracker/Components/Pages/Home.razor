@page "/"
@using Microsoft.Data.Sqlite
@using System.IO

<PageTitle>My Task Tracker</PageTitle>

<h1>My Task Tracker</h1>

<p>Remaining tasks: @tasks.Count(t => !t.IsDone)</p>

<div class="mb-3">
    <label>Task name</label>
    <input class="form-control"
           placeholder="Enter a task"
           @bind="newTask" />
</div>

<div class="mb-3">
    <label>Task Description</label>
    <input class="form-control"
           placeholder="Enter description"
           @bind="newDescription" />
</div>
<div class="mb-3">
    <label>Due Date</label>
    <input type="date"
           class="form-control"
           @bind="newDueDate" />
</div>
<button class="btn btn-primary"
        @onclick="AddTask">
    Add Task
</button>

@if (!string.IsNullOrEmpty(message))
{
    <p class="text-danger mt-2">@message</p>
}

<ul class="mt-3">
    @foreach (var task in tasks)
    {
        <li @key="task.Id" class="mb-3">
            @if (editingId == task.Id)
            {
                <input class="form-control mb-2"
                       @bind="editTitle" />

                <input class="form-control mb-2"
                       @bind="editDescription" />

                <button class="btn btn-success btn-sm"
                        @onclick="() => SaveEdit(task.Id)">
                    Save
                </button>

                <button class="btn btn-secondary btn-sm ms-2"
                        @onclick="CancelEdit">
                    Cancel
                </button>
            }
            else
            {
                <input type="checkbox"
                       checked="@task.IsDone"
                       @onchange="e => ToggleTask(task.Id, e.Value is bool b && b)" />

                <span class="ms-2"
                      style="@(task.IsDone ? "text-decoration:line-through" : "")">
                    @task.Title
                </span>

                @if (!string.IsNullOrWhiteSpace(task.Description))
                {
                    <p class="ms-4 mb-1 text-muted">
                        @task.Description
                    </p>
                }

                <button class="btn btn-warning btn-sm ms-2"
                        @onclick="() => StartEdit(task)">
                    Edit
                </button>

                <button class="btn btn-danger btn-sm ms-2"
                        @onclick="() => DeleteTask(task.Id)">
                    Delete
                </button>
            }
        </li>
    }
</ul>

@code {
    private string newTask = "";
    private string newDescription = "";
    private DateTime? newDueDate;
    private string message = "";
    private string connectionString = "";

    private List<TaskItem> tasks = new();

    private long? editingId;
    private string editTitle = "";
    private string editDescription = "";

    protected override void OnInitialized()
    {
        var folder = Path.Combine(
            Environment.GetFolderPath(
                Environment.SpecialFolder.LocalApplicationData),
            "TaskTracker");

        Directory.CreateDirectory(folder);

        var databasePath = Path.Combine(folder, "tasks.db");

        connectionString = new SqliteConnectionStringBuilder
        {
            DataSource = databasePath
        }.ToString();

        using var connection = OpenConnection();
        using var command = connection.CreateCommand();

        command.CommandText =
            "CREATE TABLE IF NOT EXISTS Tasks (" +
            "Id INTEGER PRIMARY KEY AUTOINCREMENT, " +
            "Title TEXT NOT NULL, " +
            "IsDone INTEGER NOT NULL DEFAULT 0);";

        command.ExecuteNonQuery();

        command.CommandText = "PRAGMA table_info(Tasks);";

        bool hasDescription = false;

        using (var reader = command.ExecuteReader())
        {
            while (reader.Read())
            {
                if (reader.GetString(1) == "Description")
                {
                    hasDescription = true;
                }
            }
        }

        if (!hasDescription)
        {
            command.CommandText =
                "ALTER TABLE Tasks ADD COLUMN " +
                "Description TEXT NOT NULL DEFAULT '';";

            command.ExecuteNonQuery();
        }
        command.CommandText = "PRAGMA table_info(Tasks);";
        bool hasDueDate = false;

        using (var reader = command.ExecuteReader())
        {
            while (reader.Read())
            {
                if (reader.GetString(1) == "DueDate")
                {
                    hasDueDate = true;
                }
            }
        }

        if (!hasDueDate)
        {
            command.CommandText =
                "ALTER TABLE Tasks ADD COLUMN DueDate TEXT;";
            command.ExecuteNonQuery();
        }

        LoadTasks();
    }

    private SqliteConnection OpenConnection()
    {
        var connection = new SqliteConnection(connectionString);
        connection.Open();
        return connection;
    }

    private void LoadTasks()
    {
        var loadedTasks = new List<TaskItem>();

        using var connection = OpenConnection();
        using var command = connection.CreateCommand();

        command.CommandText =
            "SELECT Id, Title, Description, IsDone, DueDate " +
            "FROM Tasks ORDER BY Id DESC;";

        using var reader = command.ExecuteReader();

        while (reader.Read())
        {
            loadedTasks.Add(new TaskItem
            {
                Id = reader.GetInt64(0),
                Title = reader.GetString(1),
                Description = reader.GetString(2),
                IsDone = reader.GetInt64(3) != 0,
                DueDate = reader.IsDBNull(4)
    ? null
    : DateTime.Parse(reader.GetString(4))
            });
        }

        tasks = loadedTasks;
    }

    private void AddTask()
    {
        if (string.IsNullOrWhiteSpace(newTask))
        {
            message = "Please enter a task name.";
            return;
        }

        using var connection = OpenConnection();
        using var command = connection.CreateCommand();

        command.CommandText =
    "INSERT INTO Tasks (Title, Description, IsDone, DueDate) " +
    "VALUES ($title, $description, 0, $dueDate);";

        command.Parameters.AddWithValue(
            "$title", newTask.Trim());

        command.Parameters.AddWithValue(
            "$description", newDescription.Trim());
        command.Parameters.AddWithValue(
"$dueDate",
newDueDate.HasValue
    ? newDueDate.Value.ToString("yyyy-MM-dd")
    : (object)DBNull.Value);

        command.ExecuteNonQuery();

        newTask = "";
        newDescription = "";
        newDueDate = null;
        message = "";

        LoadTasks();
    }

    private void ToggleTask(long id, bool isDone)
    {
        using var connection = OpenConnection();
        using var command = connection.CreateCommand();

        command.CommandText =
            "UPDATE Tasks SET IsDone = $done WHERE Id = $id;";

        command.Parameters.AddWithValue(
            "$done", isDone ? 1 : 0);

        command.Parameters.AddWithValue("$id", id);

        command.ExecuteNonQuery();
        LoadTasks();
    }

    private void StartEdit(TaskItem task)
    {
        editingId = task.Id;
        editTitle = task.Title;
        editDescription = task.Description;
        message = "";
    }

    private void SaveEdit(long id)
    {
        if (string.IsNullOrWhiteSpace(editTitle))
        {
            message = "Task name cannot be empty.";
            return;
        }

        using var connection = OpenConnection();
        using var command = connection.CreateCommand();

        command.CommandText =
            "UPDATE Tasks SET Title = $title, " +
            "Description = $description WHERE Id = $id;";

        command.Parameters.AddWithValue(
            "$title", editTitle.Trim());

        command.Parameters.AddWithValue(
            "$description", editDescription.Trim());

        command.Parameters.AddWithValue("$id", id);

        command.ExecuteNonQuery();

        editingId = null;
        message = "";

        LoadTasks();
    }

    private void CancelEdit()
    {
        editingId = null;
        message = "";
    }

    private void DeleteTask(long id)
    {
        using var connection = OpenConnection();
        using var command = connection.CreateCommand();

        command.CommandText =
            "DELETE FROM Tasks WHERE Id = $id;";

        command.Parameters.AddWithValue("$id", id);

        command.ExecuteNonQuery();

        message = "";
        LoadTasks();
    }

    private class TaskItem
    {
        public long Id { get; set; }
        public string Title { get; set; } = "";
        public string Description { get; set; } = "";
        public bool IsDone { get; set; }
        public DateTime? DueDate { get; set; }
    }
}
